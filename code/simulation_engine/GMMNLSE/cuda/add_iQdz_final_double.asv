__global__ void add_iQdz_final(double2* A_rmc,
                               const double2* A,
                               const double2* iQdz, const double2* iQdz_2, const double2* iQdz_,
                               const unsigned int N, const unsigned int M, const unsigned int NUM_MODES) {
    const unsigned int full_thread_idx = threadIdx.x + blockIdx.x*blockDim.x;

    // Calculate the index
    const unsigned int midx = full_thread_idx / N;
    const unsigned int Nidx = full_thread_idx - midx*N;
    

    if (full_thread_idx >= N*NUM_MODES) {
        return;
    }

    double2 A_rmc_Ni;
    A_rmc_Ni.x = 0; A_rmc_Ni.y = 0; // initialized
    unsigned int I = 0;
    // Compute the random mode coupling
    for (int i = 0; i < NUM_MODES; i++) {
        if (i == midx) {
            I = 1;
        } else {
            I = 0;
        }
        A_rmc_Ni.x += ((I+M*iQdz[i*NUM_MODES+midx].x)*A[Nidx+i*N].x - M*iQdz[i*NUM_MODES+midx].y*A[Nidx+i*N].y);
        A_rmc_Ni.y += ((I+M*iQdz[i*NUM_MODES+midx].x)*A[Nidx+i*N].y + M*iQdz[i*NUM_MODES+midx].y*A[Nidx+i*N].x);
    }
    A_rmc[Nidx+midx*N] = A_rmc_Ni;
}